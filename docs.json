{
	"$schema": "https://mintlify.com/docs.json",
	"theme": "palm",
	"name": "Stars Components",
	"colors": {
		"primary": "#5865f2",
		"light": "#798df9",
		"dark": "#5865f2"
	},
	"logo": {
		"light": "/logo/light.svg",
		"dark": "/logo/dark.svg"
	},
	"favicon": "/favicon.svg",
