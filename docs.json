{
	"$schema": "https://mintlify.com/docs.json",
	"theme": "palm",
	"name": "Stars Components",
	"colors": {
		"primary": "#5865f2",
		"light": "#798df9",
		"dark": "#5865f2"
	},
	"logo": {
		"light": "/logo/light.svg",
		"dark": "/logo/dark.svg"
	},
	"favicon": "/favicon.svg",
	"navbar": {
		"links": [
			{
				"type": "discord",
				"label": "Community",
				"href": "https://join.wolfstar.rocks"
			}
		],
		"primary": {
			"type": "github",
			"href": "https://github.com/wolfstar-project/stars-components"
		}
	},
	"appearance": {
		"default": "dark"
	},
	"styling": {
		"codeblocks": "system",
		"eyebrows": "breadcrumbs"
	},
	"background": {
		"color": {
			"light": "#ffffff",
			"dark": "#202024"
		},
		"decoration": "gradient"
	},
	"contextual": {
		"options": ["copy", "view", "chatgpt", "claude", "perplexity", "mcp", "cursor", "vscode"],
		"display": "header"
	},
	"navigation": {
		"global": {
			"anchors": [
				{
					"anchor": "Documentation",
					"icon": "book-open-cover",
					"href": "/documentation"
				}
			]
		},
		"tabs": [
			{
				"tab": "Guides",
				"icon": "book-open",
				"pages": ["docs/guides", "quickstart", "documentation/guide/index", "documentation/index"]
			},
			{
				"tab": "Changelog",
				"icon": "list",
				"pages": ["docs/changelog"]
			},
			{
				"tab": "API Reference",
				"icon": "code",
				"pages": ["docs/api-reference", "documentation/api/index"]
			},
			{
				"tab": "Library",
				"icon": "boxes-stacked",
				"pages": ["docs/library", "documentation/packages/index"]
			}
		]
	},
	"description": "Build own star network"
}
