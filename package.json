{
	"name": "@wolfstar/website",
	"private": true,
	"description": "The wolfstar-project documentation site (Fumadocs)",
	"type": "module",
	"scripts": {
		"prepare": "husky || true",
		"fetch-docs-data": "node scripts/fetch-docs-data.mjs",
		"api": "typedoc --options typedoc.json && node scripts/postprocess-api.mjs",
		"predev": "pnpm fetch-docs-data",
		"dev": "pnpm api && next dev",
		"prebuild": "pnpm fetch-docs-data",
		"build": "pnpm api && next build",
		"start": "next start",
		"pretypecheck": "pnpm fetch-docs-data && pnpm api",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint . && oxfmt --check .",
		"lint:fix": "oxlint --fix . && oxfmt --write .",
		"generate-pwa-assets": "pwa-assets-generator --preset minimal-2023 public/logo.svg"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.0",
		"@commitlint/config-conventional": "^21.2.0",
		"@discordjs/builders": "^1.14.1",
		"@netlify/plugin-nextjs": "^5.15.13",
		"@sapphire/ts-config": "^5.0.3",
		"@serwist/turbopack": "^9.5.12",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/mdast": "^4.0.4",
		"@types/mdx": "^2.0.14",
		"@types/node": "22.15.21",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vite-pwa/assets-generator": "^1.0.2",
		"@wolfstar/env-utilities": "^2.0.3",
		"@wolfstar/http-framework": "^3.1.0",
		"@wolfstar/http-framework-test-utils": "^3.0.1",
		"@wolfstar/shared-http-pieces": "^1.2.6",
		"@wolfstar/shared-influx-pieces": "^1.1.3",
		"cz-conventional-changelog": "^3.3.0",
		"discord-api-types": "^0.38.8",
		"esbuild": "^0.28.2",
		"fumadocs-core": "^16.15.9",
		"fumadocs-mdx": "^15.4.0",
		"fumadocs-twoslash": "^4.0.0",
		"fumadocs-ui": "^16.15.9",
		"husky": "9.1.7",
		"mdast-util-directive": "^3.1.0",
		"nano-staged": "1.0.2",
		"next": "^16.3.5",
		"oxfmt": "0.57.0",
		"oxlint": "1.72.0",
		"postcss": "^8.5.28",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"remark-directive": "^4.0.0",
		"serwist": "^9.5.12",
		"shiki": "^4.4.3",
		"tailwindcss": "^4.3.3",
		"typedoc": "^0.28.20",
		"typedoc-plugin-markdown": "^4.12.0",
		"typescript": "~5.8.3",
		"zod": "^4.6.4"
	},
	"nano-staged": {
		"*.{ts,mts,cts,tsx,mjs,cjs,js,jsx,json,jsonc,yml,yaml,md,mdx}": "oxfmt --no-error-on-unmatched-pattern",
		"*.{ts,mts,cts,tsx,mjs,cjs,js,jsx}": "oxlint --fix"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@11.5.0"
}
