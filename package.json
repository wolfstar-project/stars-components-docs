{
	"name": "@wolfstar/website",
	"private": true,
	"description": "The wolfstar-project documentation site (Mintlify)",
	"type": "module",
	"scripts": {
		"prepare": "husky",
		"lint": "oxlint . && oxfmt --check .",
		"lint:fix": "oxlint --fix . && oxfmt --write ."
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.0",
		"@commitlint/config-conventional": "^21.2.0",
		"cz-conventional-changelog": "^3.3.0",
		"husky": "9.1.7",
		"nano-staged": "1.0.2",
		"oxfmt": "0.57.0",
		"oxlint": "1.72.0"
	},
	"nano-staged": {
		"*.{ts,mts,cts,tsx,mjs,cjs,js,jsx,json,jsonc,yml,yaml,md}": "oxfmt --no-error-on-unmatched-pattern",
		"*.{ts,mts,cts,tsx,mjs,cjs,js,jsx}": "oxlint --fix"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@11.5.0"
}
